<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/radiant_bg">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Market Price"
        android:textSize="38sp"
        android:textStyle="bold"
        android:textColor="@color/darkGreen_text"
        android:gravity="center"
        android:layout_marginVertical="50dp"/>

    <LinearLayout
        android:id="@+id/cardMarketPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:background="@color/newgreen"

        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:contentDescription="market Price"
            android:src="@drawable/mk_price_icon"
            android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Market Price"
                android:textSize="22sp"
                android:textColor="@color/darkGreen_text"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvMarketPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹1,200"
                android:textSize="18sp"
                android:textColor="@color/darkGreen_text"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/Calculate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:layout_marginBottom="16dp"
        android:background="@color/newgreen">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:contentDescription="calculate"
            android:src="@drawable/calculator_icon"
            android:layout_marginEnd="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calculate"
            android:layout_marginTop="16dp"
            android:textSize="22sp"
            android:textColor="@color/darkGreen_text"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardPricingInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:background="@color/newgreen">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:contentDescription="pricing information"
            android:src="@drawable/pricing_info_icon"
            android:layout_marginEnd="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pricing Info"
            android:layout_marginTop="16dp"
            android:textSize="22sp"
            android:textColor="@color/darkGreen_text"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
