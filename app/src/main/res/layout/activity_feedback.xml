<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/radiant_bg"
    android:gravity="center"
    android:id="@+id/feedback">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Feedback"
        android:textSize="38sp"
        android:textColor="@color/darkGreen_text"
        android:textStyle="bold"
        android:layout_marginBottom="35dp"
        android:textAlignment="center"/>

    <EditText
        android:id="@+id/Userfeedback"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:autofillHints="feedback"
        android:background="@color/text_view_background"
        android:hint="@string/feedback"
        android:textColorHint="@color/gray"
        android:inputType="text"
        android:padding="20dp"
        android:textSize="18sp"
        android:textColor="@color/black"
        android:layout_marginHorizontal="15dp"/>

    <Button
        android:id="@+id/submit_btn"
        android:layout_marginTop="35dp"
        android:text="@string/submit_btn"
        android:layout_width="match_parent"
        style="@style/button_view_presets"/>

</LinearLayout>