<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/radiant_bg"
    android:gravity="center"
    android:id="@+id/addCropDetails">

    <EditText
        android:id="@+id/cropname"
        android:autofillHints="Crop Name"
        android:hint="@string/entercropname"
        android:layout_width="match_parent"
        style="@style/edit_text_presets"
        android:layout_marginBottom="0dp"/>

    <Spinner
        android:id="@+id/cropTypeDropdown"
        style="@style/txt_input_layer"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:textAlignment="center" />

    <EditText
        android:id="@+id/dateInput"
        android:layout_width="match_parent"
        style="@style/edit_text_presets"
        android:hint="@string/plantingDate"
        android:focusable="false"
        android:inputType="date"
        android:textColorHint="@color/text_view_textColorHint"
        android:layout_marginBottom="0dp"
        android:drawableStart="@drawable/ic_calendar"/>

    <Spinner
        android:id="@+id/cropStatusDropdown"
        style="@style/txt_input_layer"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:textAlignment="center" />

    <Button
        android:id="@+id/AddCropDetailsBTN"
        android:layout_width="match_parent"
        style="@style/button_view_presets"
        android:layout_marginStart="80dp"
        android:layout_marginEnd="80dp"
        android:layout_marginTop="35dp"
        android:text="@string/addCrop"/>
    
</LinearLayout>