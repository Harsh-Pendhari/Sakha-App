<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="edit_text_presets" parent="Widget.AppCompat.EditText">
        <item name="android:layout_height">@dimen/text_view_height</item>
        <item name="android:padding">@dimen/text_view_padding</item>
        <item name="android:textSize">@dimen/text_view_textSize</item>
        <item name="android:layout_marginBottom">@dimen/text_view_bottom_margin</item>
        <item name="android:layout_marginTop">@dimen/text_view_top_margin</item>
        <item name="android:drawablePadding">@dimen/text_view_drawablePadding</item>
        <item name="android:background">@color/text_view_background</item>
        <item name="android:layout_marginStart">@dimen/text_view_layout_marginStart</item>
        <item name="android:layout_marginEnd">@dimen/text_view_layout_marginEnd</item>
        <item name="android:elevation">@dimen/text_view_elevation</item>
        <item name="android:textColorHint">@color/text_view_textColorHint</item>
        <item name="android:textColor">@color/text_view_textColor</item>
    </style>

    <style name="button_view_presets" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:textSize">@dimen/button_textSize</item>
        <item name="android:padding">@dimen/button_padding</item>
        <item name="android:elevation">@dimen/button_elevation</item>
        <item name="android:layout_marginTop">@dimen/button_topMargin</item>
        <item name="android:layout_marginEnd">@dimen/button_margin</item>
        <item name="android:layout_marginStart">@dimen/button_margin</item>
        <item name="backgroundTint">@color/btn_bg_tint</item>
        <item name="android:textColor">@color/btn_textColor</item>
        <item name="cornerRadius">@dimen/button_roundness</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="No_bg_logo_presets">
        <item name="android:layout_width">@dimen/No_Bg_ImageWidth</item>
        <item name="android:layout_height">@dimen/No_Bg_ImageHeight</item>
    </style>

    <style name="CustomHintText" parent="@style/TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_view_textColorHint</item>
    </style>

    <style name="txt_input_layer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/layoutHeight</item>
        <item name="android:background">@color/text_view_background</item>
        <item name="android:layout_marginStart">@dimen/layoutMarginHorizontal</item>
        <item name="android:layout_marginEnd">@dimen/layoutMarginHorizontal</item>
        <item name="android:elevation">@dimen/elevation</item>
        <item name="android:layout_marginTop">@dimen/layoutMarginTop</item>
        <item name="android:textColorHint">@color/text_view_textColorHint</item>
    </style>

    <style name="autocomplete_txt_view">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:completionThreshold">1</item>
        <item name="android:dropDownWidth">match_parent</item>
        <item name="android:textSize">@dimen/textSizeAutocomplete</item>
        <item name="android:dropDownHeight">@dimen/dropDownHeightAutocomplete</item>
        <item name="android:inputType">text</item>
        <item name="android:padding">@dimen/paddingAutocomplete</item>
        <item name="android:textColor">@color/text_view_textColor</item>
        <item name="android:textColorHint">#913C3B3B</item>
        <item name="android:layout_marginBottom">@dimen/layout_marginBottomAutocomplete</item>
    </style>

    <style name="GridImageButtonStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:background">@drawable/rounded_button_bg</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:backgroundTint">#FDFAE0</item>
        <item name="android:padding">15dp</item>
    </style>

    <style name="market_stylePresets">
        <item name="android:layout_width">325dp</item>
        <item name="android:layout_height">55dp</item>
        <item name="android:background">@color/transparentBg</item>
        <item name="android:textColor">@color/gray</item>
        <item name="android:textSize">18sp</item>
        <item name="android:elevation">10dp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>
</resources>